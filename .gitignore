# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/

# Session/agent tooling — never part of the factory
.remember/
.superstack/
.v2c/
.video_agent/
out/

# Run dirs live OUTSIDE the repo (~/factory/runs/, DESIGN D3) — nothing to ignore here.
# .factory/tasks.json and .factory/project.yaml ARE committed.

# OS
.DS_Store

# Writer lock for tasks.json (F-03) — runtime artifact, never committed
.factory/*.lock

# srt (sandbox runtime) — pinned in package.json; only the lockfile is committed
node_modules/

# Secrets — never committed (the Z.ai credential lives in the macOS keychain,
# item factory-zai; nothing on disk should ever hold a real key)
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
.netrc
.npmrc
.pypirc
id_rsa*
id_ed25519*
credentials.json
secrets.*
