+            _verdict(
+                _finding("wrong value returned", file="impl.py"),
+                _finding("also the wrong sign", file="impl.py"),
+            ),
+            _verdict(),  # round 3 passes: PR opens
+        ),
+    )
+    assert env3.run(seats3).outcome == "pr_opened"
