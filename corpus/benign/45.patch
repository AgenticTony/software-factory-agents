+
+    def fake_sleep(seconds):
+        slept["n"] += 1
+        if slept["n"] == 1:  # mid-follow: the run finishes
+            path.open("a").write(json.dumps({
+                "type": "run_end", "outcome": "failed", "seq": 3,
+                "ts": "2026-10-23T10:00:02Z", "run_id": RUN_ID_2, "task_id": "T-1",
+                "attempt": 1,
