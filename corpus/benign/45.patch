+    before = path.read_text()
+    listing = sorted(p.name for p in (env.root / "trace" / "fixture").iterdir())
+    assert listing == [f"{RUN_ID}.jsonl", f"{RUN_ID_2}.jsonl"]
+    real_sleep = time_mod.sleep
