+    seen: dict[str, str] = {}
+
+    async def probing_query(*, prompt, options, transport=None):
+        for key in list(planted) + ["PATH", "ANTHROPIC_BASE_URL"]:
+            seen[key] = os.environ.get(key)
+        yield _result()
