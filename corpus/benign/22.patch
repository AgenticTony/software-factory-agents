+
+    commands = {c["name"]: c["output"] for c in result.reports["L0"]["commands"]}
+    commands.update({c["name"]: c["output"] for c in result.reports["L1"]["commands"]})
+    gated = ["test", f"red:{REF}", f"green:{REF}"]
+    for name in gated:
